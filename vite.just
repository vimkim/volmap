# Frontend build and verification primitives. These commands do not start Volmap.

set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

# Install the exact frontend graph without executing dependency lifecycle scripts.
frontend-install:
    mise x node@24.19.0 -- corepack pnpm --dir web install --frozen-lockfile --ignore-scripts

# Install the exact Chromium and Firefox revisions owned by pinned Playwright.
frontend-install-browsers: frontend-install
    mise x node@24.19.0 -- corepack pnpm --dir web exec playwright install chromium firefox

# Typecheck and test React, then regenerate the committed bundle and supply-chain evidence.
frontend-generate-artifacts: frontend-install
    mise x node@24.19.0 -- release/regenerate-frontend.sh

# Check types, tests, advisories, generated bytes, browsers, and Cargo-only embedding.
frontend-check: frontend-install
    mise x node@24.19.0 -- release/check-frontend.sh
